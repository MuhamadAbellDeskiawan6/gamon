rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'muhamadabelldeskiawan@gmail.com';
    }

    // ID thread chat milik pembeli: "{uid}" (chat lama) atau "{uid}__..." (per produk/pesanan/umum).
    function ownsChatId(chatId) {
      return isSignedIn() && (
        chatId == request.auth.uid ||
        chatId.matches(request.auth.uid + '__.*')
      );
    }

    function validCartItem(items, index) {
      return items.size() <= index || (
        items[index] is map &&
        items[index].keys().hasOnly(['productId', 'qty']) &&
        items[index].productId is string &&
        items[index].productId.size() > 0 &&
        items[index].qty is int &&
        items[index].qty >= 1 &&
        items[index].qty <= 99
      );
    }

    function validCartItems(items) {
      return items is list && items.size() <= 30 &&
        validCartItem(items, 0) && validCartItem(items, 1) && validCartItem(items, 2) &&
        validCartItem(items, 3) && validCartItem(items, 4) && validCartItem(items, 5) &&
        validCartItem(items, 6) && validCartItem(items, 7) && validCartItem(items, 8) &&
        validCartItem(items, 9) && validCartItem(items, 10) && validCartItem(items, 11) &&
        validCartItem(items, 12) && validCartItem(items, 13) && validCartItem(items, 14) &&
        validCartItem(items, 15) && validCartItem(items, 16) && validCartItem(items, 17) &&
        validCartItem(items, 18) && validCartItem(items, 19) && validCartItem(items, 20) &&
        validCartItem(items, 21) && validCartItem(items, 22) && validCartItem(items, 23) &&
        validCartItem(items, 24) && validCartItem(items, 25) && validCartItem(items, 26) &&
        validCartItem(items, 27) && validCartItem(items, 28) && validCartItem(items, 29);
    }

    /* =====================================================================
     * MARKETPLACE  (dikunci ketat)
     * ===================================================================== */

    match /marketplace_users/{userId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && userId == request.auth.uid && request.resource.data.role in ['buyer', 'both'];
      allow update: if isSignedIn() && userId == request.auth.uid && request.resource.data.role in ['buyer', 'both'];
      allow delete: if false;
    }

    match /marketplace_products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /marketplace_orders/{orderId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /marketplace_carts/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['items', 'updatedAt']) &&
        request.resource.data.updatedAt is int &&
        validCartItems(request.resource.data.items);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /marketplace_chats/{chatId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource == null ||
        resource.data.buyerId == request.auth.uid
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        (ownsChatId(chatId) && request.resource.data.buyerId == request.auth.uid)
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.buyerId == request.auth.uid &&
          request.resource.data.buyerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'buyerId', 'buyerName', 'buyerEmail', 'participantIds', 'type',
            'productId', 'productName', 'productImage', 'orderId',
            'lastMessage', 'lastMessageAt', 'lastSenderRole',
            'updatedAt', 'createdAt', 'unreadForAdmin', 'unreadForUser'
          ])
        )
      );

      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          get(/databases/$(database)/documents/marketplace_chats/$(chatId)).data.buyerId == request.auth.uid
        );

        allow create: if isSignedIn() && (
          (isAdmin() && request.resource.data.senderRole == 'admin') ||
          (
            ownsChatId(chatId) &&
            request.resource.data.senderRole == 'user' &&
            request.resource.data.senderId == request.auth.uid
          )
        );

        allow update, delete: if isAdmin();
      }
    }

    /* =====================================================================
     * FOTO LDR  (baca publik, tulis hanya lewat API server)
     * ===================================================================== */

    match /fotoLdrSessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /ldr_order/{orderId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    /* =====================================================================
     * SEMENTARA TERBUKA (sama seperti kondisi sekarang).
     * Kode browser untuk fitur ini belum diperiksa. Jangan dikencangkan
     * sebelum kode submit.html, match-confirm.html, index-main.js, dan
     * user/undangan/assets/app.js dicek, supaya fiturnya tidak rusak.
     * ===================================================================== */

    match /gamon/{docId} {
      allow read, write: if true;
    }
    match /matchRequests/{docId} {
      allow read, write: if true;
    }
    match /matches/{docId} {
      allow read, write: if true;
    }
    match /matchContacts/{docId} {
      allow read, write: if true;
    }
    match /gamon_wedding_users/{docId} {
      allow read, write: if true;
    }
    match /gamon_wedding_invitations/{docId} {
      allow read, write: if true;
    }
    match /gamon_wedding_rsvps/{docId} {
      allow read, write: if true;
    }

    // Koleksi lain (orders, photobox_*, ldr_frames, marketplace_items, dst.)
    // tidak dicantumkan -> ditolak untuk browser, tetap bisa lewat API (Admin SDK).
  }
}